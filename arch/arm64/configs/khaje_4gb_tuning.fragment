#
# Khaje 4 GB — tuning de fluidez + bateria
# Alvo: Redmi Note 12 4G / Note 13 4G NFC / Redmi Pad SE (SM6225, 4 GB RAM)
#
# Este fragmento e aplicado por cima de gki_defconfig, unified_defconfig e
# khaje-stock_defconfig. Ele remove o custo de instrumentacao de debug (que
# pesa muito em CPU e RAM num SoC de entrada com 4 GB) e liga recursos que
# melhoram a resposta do sistema sob pressao de memoria.
#
# Detalhes, medicao de impacto e como reverter: README-KHAJE-4GB.md
#

#
# 1) Overhead de debug: desligado
#    KASAN mantem shadow memory (~1/8 da RAM) + quarentena + hooks em toda
#    alocacao; PAGE_OWNER liga PAGE_EXTENSION (array extra por pagina,
#    alocado no boot); UBSAN_BOUNDS insere checagem em todo acesso a array;
#    DEBUG_LIST checa listas nas rotas quentes do scheduler; INIT_ON_ALLOC
#    zera toda alocacao (banda de memoria).
#
# CONFIG_KASAN is not set
# CONFIG_KFENCE is not set
# CONFIG_UBSAN is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_PAGE_PINNER is not set
# CONFIG_PAGE_EXTENSION is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_BUG_ON_DATA_CORRUPTION is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_WERROR is not set
# CONFIG_KASAN_VMALLOC is not set

#
# 2) Memoria: reclaim multi-geracional (MGLRU) ativo por padrao.
#    Menos tempo em lru_lock, escolha melhor da pagina a descartar e
#    muito menos jank quando a RAM enche. E o recurso mais importante
#    para um aparelho de 4 GB.
#
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set

#
# 3) zram/zsmalloc: comprimido em lz4kd (ratio melhor que lzo-rle com
#    velocidade de lz4) e sem estatisticas de zsmalloc.
#    O tamanho do zram e o algoritmo sao ajustados em runtime pelo
#    modulo de tuning (tuning/).
#
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_ZRAM_DEF_COMP_LZ4KD=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_ZSMALLOC=y
# CONFIG_ZSMALLOC_STAT is not set

#
# 4) Bateria: callbacks RCU "preguicosos" por padrao (so tem efeito se o
#    cmdline do boot tiver rcu_nocbs=all; ver README-KHAJE-4GB.md) e filas
#    de trabalho com WQ_POWER_EFFICIENT.
#
# CONFIG_RCU_LAZY_DEFAULT_OFF is not set
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_NO_HZ_IDLE=y

#
# 5) Scheduler/frequencia: mantem EAS, SCHED_DEBUG (tunables em runtime),
#    UCLAMP e TEO de idle. HZ nao e alterado de proposito para nao mudar o
#    comportamento dos modulos vendor ja compilados contra o GKI.
#
CONFIG_ENERGY_MODEL=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_THERMAL_PRESSURE=y
CONFIG_UCLAMP_TASK=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_SCHED_DEBUG=y

#
# 6) I/O: desliga a contabilidade de iostat do f2fs (caminho quente de
#    toda escrita do /data) e deixa o SSG (scheduler da MSM, feito para
#    mobile) como padrao, com BFQ/kyber/mq-deadline disponiveis para
#    troca em runtime.
#
# CONFIG_F2FS_IOSTAT is not set
CONFIG_MQ_IOSCHED_SSG=y
CONFIG_MQ_SSG_DEFAULT=y
CONFIG_IOSCHED_BFQ=y

#
# 7) Compatibilidade com root/KernelSU/SUSFS e apps que usam xattr em tmpfs.
#
CONFIG_KALLSYMS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

#
# 8) Khaje builtin tuning - aplica perfil balanced sem módulo externo
#    Elimina necessidade de tuning/khaje-tune.sh e tuning/build-module.sh
#
CONFIG_KHAJE_4GB_BUILTIN_TUNING=y

#
# 9) Rede: BBR como congestion default para melhor throughput/latência
#
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_TCP_CONG="bbr"
